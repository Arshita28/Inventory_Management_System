# Local development uses H2 when INVENTORY_JDBC_URL is unset.
# Configure these in your host's secret settings, not source control.
INVENTORY_JDBC_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/inventory?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem
INVENTORY_DB_USER=YOUR_DATABASE_USER
INVENTORY_DB_PASSWORD=SET_IN_HOST_SECRET_MANAGER
INVENTORY_DB_POOL_SIZE=5
INVENTORY_DB_SCHEMA=inventory
# Enable these only when deploying behind an HTTPS reverse proxy.
INVENTORY_ENV=production
INVENTORY_PUBLIC_ORIGIN=https://inventory.example.com
INVENTORY_BIND_ADDRESS=0.0.0.0
PORT=8080
